# ─── Site ───────────────────────────────────────────────────────────────
# Public URL, used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ─── Content database (Supabase) — see supabase/README.md ───────────────
# Project Settings → API. Only the public anon key belongs here;
# never add the service role key to this project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Contact form delivery (optional) ───────────────────────────────────
# Any endpoint accepting a JSON POST (Formspree, Make, Zapier, Apps Script…).
ENQUIRY_WEBHOOK_URL=

# ─── Local preview CMS (development only, never on Vercel) ──────────────
# Stores content in .data/ on this computer when Supabase is not configured.
CMS_LOCAL_MODE=false
LOCAL_ADMIN_PASSWORD=
